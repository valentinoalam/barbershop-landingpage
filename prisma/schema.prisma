// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}


model Office {
  id        String   @id @default(cuid())
  location  String // ditampilkan di UI, mis. "Downtown Branch"
  address   String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  barbers   BarberOffice[]
  schedules BarberSchedule[]
  bookings  Booking[]

  @@map("offices")
}

model Barber {
  id              String   @id @default(cuid())
  name            String
  image           String?
  specialty       String?
  experienceYears Int?
  bio             String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  offices   BarberOffice[]
  schedules BarberSchedule[]
  bookings  Booking[]

  @@map("barbers")
}

// Many-to-many: satu barber bisa kerja di beberapa cabang
model BarberOffice {
  id       String @id @default(cuid())
  barberId String
  officeId String

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)
  office Office @relation(fields: [officeId], references: [id], onDelete: Cascade)

  @@unique([barberId, officeId])
  @@map("barber_offices")
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

// Jadwal kerja mingguan tiap barber per cabang, dipakai untuk generate slot
// yang tersedia di /api/availability
model BarberSchedule {
  id        String    @id @default(cuid())
  barberId  String
  officeId  String
  dayOfWeek DayOfWeek
  startTime String // format "HH:mm", mis. "09:00"
  endTime   String // format "HH:mm", mis. "17:00"
  isOff     Boolean   @default(false)

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)
  office Office @relation(fields: [officeId], references: [id], onDelete: Cascade)

  @@unique([barberId, officeId, dayOfWeek])
  @@map("barber_schedules")
}

model Service {
  id              String   @id @default(cuid())
  name            String
  description     String?
  price           Int // dalam sen/cent (mis. $25.00 -> 2500) agar tidak ada floating point
  durationMinutes Int
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  bookings Booking[]

  @@map("services")
}


// ---------------------------------------------------------------------------
// Customer & booking
// ---------------------------------------------------------------------------

model User {
  id        String   @id @default(cuid())
  name      String
  lastName  String   @map("last_name")
  email     String   @unique
  phone     String
  admin     Boolean  @default(false)
  confirm   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  customer Customer? 
  @@map("users")
}
model Customer {
  id        String   @id @default(cuid())
  userId    String   @unique
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user     User @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings Booking[]
  purchaseOrders PurchaseOrder[] @relation("UserPurchaseOrders")
  @@map("customers")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model Booking {
  id              String        @id @default(cuid())
  customerId      String
  serviceId       String
  barberId        String
  officeId        String
  appointmentDate DateTime // hanya tanggal (jam disimpan di startTime/endTime)
  startTime       String // "HH:mm"
  endTime         String // "HH:mm", dihitung dari service.durationMinutes
  status          BookingStatus @default(PENDING)
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])
  service  Service  @relation(fields: [serviceId], references: [id])
  barber   Barber   @relation(fields: [barberId], references: [id])
  office   Office   @relation(fields: [officeId], references: [id])

  // Mencegah barber yang sama double-booked di tanggal & jam yang sama
  @@unique([barberId, appointmentDate, startTime])
  @@index([barberId, appointmentDate])
  @@index([officeId, appointmentDate])
  @@map("bookings")
}

model Products {
  id          String  @id @default(cuid())
  name        String
  price       Float
  description String
  stock       Int
  available   Boolean @default(true)
  favorite    Boolean @default(false)
  categoryId  String? @map("category_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  category       Category? @relation(fields: [categoryId], references: [id])
  purchaseOrders PurchaseOrder[]

  @@map("products")
}

model PayMethods {
  id          String @id @default(cuid())
  description String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  purchaseOrders PurchaseOrder[]

  @@map("pay_methods")
}

model PurchaseOrder {
  id         String @id @default(cuid())
  customerId     String @map("user_id")
  productId  String @map("prod_id")
  payMethodId String @map("pm_id")
  quantity   Int    @map("quant_prod")
  amount     Float  @map("ammount")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relations
  customer      Customer       @relation("UserPurchaseOrders", fields: [customerId], references: [id])
  product   Products   @relation(fields: [productId], references: [id], onDelete: Cascade)
  payMethod PayMethods @relation(fields: [payMethodId], references: [id], onDelete: Cascade)

  @@map("purchase_orders")
}

model Category {
  id          String @id @default(cuid())
  description String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  products Products[]

  @@map("categorys")
}
